log_section "Configuring Activity Monitor..."

log_msg "Showing the main window on launch"
defaults write com.apple.ActivityMonitor OpenMainWindow -bool true               # Show main window on launch

log_msg "Visualizing CPU usage in the Dock icon"
defaults write com.apple.ActivityMonitor IconType -int 5                         # Set Dock icon to show CPU usage

log_msg "Showing all processes by default"
defaults write com.apple.ActivityMonitor ShowCategory -int 0                     # Show all processes by default

log_msg "Sorting processes by CPU usage"
defaults write com.apple.ActivityMonitor SortColumn -string "CPUUsage"           # Set sort column to CPU Usage

log_msg "Setting sort direction to descending"
defaults write com.apple.ActivityMonitor SortDirection -int 0                    # Set sort direction to descending

