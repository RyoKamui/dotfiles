log_section "Configuring Terminal.app..."

log_msg "Setting Terminal to use UTF-8 only"
defaults write com.apple.terminal StringEncodings -array 4                       # Use UTF-8 encoding

log_msg "Enabling Secure Keyboard Entry"
defaults write com.apple.terminal SecureKeyboardEntry -bool true                 # Enable Secure Keyboard Entry

# Download and apply terminal theme
log_msg "Applying the 'Macchiato' theme"
(
  curl -LOJs https://raw.githubusercontent.com/RyoKamui/assets/main/profiles/terminal/Macchiato.terminal && \
  theme=$(<Macchiato.terminal) && \
  plutil -replace 'Window Settings.Macchiato' -xml "$theme" ~/Library/Preferences/com.apple.Terminal.plist && \
  defaults write com.apple.terminal 'Default Window Settings' -string Macchiato && \
  defaults write com.apple.terminal 'Startup Window Settings' -string Macchiato && \
  osascript -e 'tell application "Terminal" to set current settings of first window to settings set "Macchiato"' && \
  rm Macchiato.terminal
)

