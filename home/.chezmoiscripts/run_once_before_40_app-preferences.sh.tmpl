# ■ APPLY SYSTEM-WIDE APPLICATION PREFERENCES
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# This script configures preferences for built-in macOS applications and services.
# It is idempotent and can be re-run without issue.

# ────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────
# Boilerplate and Functions
# ────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────

# Record start time
start_time=$(date +%s)

# Get params
params="$params $*"

# Color variables
PRIMARY_COLOR='\033[0;32m'
ACCENT_COLOR='\033[0;34m'
INFO_COLOR='\033[1;33m'
INFO_COLOR_U='\033[1;37m'
SUCCESS_COLOR='\033[0;32m'
WARN_1='\033[1;31m'
WARN_2='\033[0;31m'
RESET_COLOR='\033[0m'

# Current and total tasks, used for progress updates
current_event=0
total_events=77

# Helper function to log progress to console
function log_msg () {
  current_event=$(($current_event + 1))
  if [[ ! $params == *"--silent"* ]]; then
    if (("$current_event" < 10 )); then sp='0'; else sp=''; fi
    echo -e "${PRIMARY_COLOR}[${sp}${current_event}/${total_events}] ${ACCENT_COLOR}${1}${INFO_COLOR}"
  fi
}

# Helper function to log section to console
function log_section () {
  if [[ ! $params == *"--silent"* ]]; then
    echo -e "\n${PRIMARY_COLOR}[INFO ] ${1}${INFO_COLOR}"
  fi
}

# pb_set <plist> <key.path> <type> <value>: set a leaf value, creating any
# missing intermediate dictionaries and the leaf itself. A bare "Set" fails on
# a fresh machine where Finder has not saved its view settings yet.
function pb_set () {
  local pb=/usr/libexec/PlistBuddy plist="$1" keypath="$2" type="$3" value="$4" prefix="" seg i
  local -a segs
  segs=("${(s.:.)keypath}")
  "$pb" -c "Set :$keypath $value" "$plist" 2>/dev/null && return 0
  for (( i = 1; i <= ${#segs} - 1; i++ )); do
    seg="${segs[i]}"
    if [[ -n "$prefix" ]]; then
      "$pb" -c "Add :$prefix:$seg dict" "$plist" 2>/dev/null
    else
      "$pb" -c "Add :$seg dict" "$plist" 2>/dev/null
    fi
    prefix="${prefix:+$prefix:}$seg"
  done
  "$pb" -c "Add :$keypath $type $value" "$plist" 2>/dev/null
}

# ────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────
# Execution Start
# ────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────

if [[ ! $params == *"--skip-intro"* ]]; then
  clear
  echo -e "${PRIMARY_COLOR}Applying macOS App Preferences...${RESET_COLOR}"
  echo -e "${WARN_1}IMPORTANT:${WARN_2} This script will make changes to your system."
fi

echo -e "${ACCENT_COLOR}\nElevated permissions are required for some settings."
sudo -v
if [ $? -ne 0 ]; then
    echo -e "${ACCENT_COLOR}Unable to continue without sudo permissions. Exiting...${RESET_COLOR}"
    exit 1
fi

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# ■ SECTION: FINDER
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
log_section "Configuring Finder..."

log_msg "Setting new windows to open to Home"
defaults write com.apple.finder NewWindowTarget -string "PfHm"                          # Set new window target to home directory

log_msg "Setting new tabs to open to file root"
defaults write com.apple.finder NewWindowTargetPath -string "file:///"                  # Set new tab target to root

log_msg "Showing all file extensions in filenames"
defaults write NSGlobalDomain AppleShowAllExtensions -bool true                         # Show all filename extensions

log_msg "Disabling the empty trash confirmation"
defaults write com.apple.finder WarnOnEmptyTrash -bool false                            # Disable warning before emptying trash

log_msg "Showing all network locations and drives"
defaults write com.apple.NetworkBrowser BrowseAllInterfaces -bool true                  # Browse all network interfaces

log_msg "Showing the user's Library folder"
chflags nohidden ~/Library && xattr -d com.apple.FinderInfo ~/Library > /dev/null 2>&1  # Unhide the user's Library folder

log_msg "Showing the main Volumes folder"
sudo chflags nohidden /Volumes                                                          # Unhide the Volumes folder

log_msg "Allowing Finder to be quit with ⌘+Q"
defaults write com.apple.finder QuitMenuItem -bool true                                 # Enable Quit menu item for Finder

log_msg "Showing the status bar in Finder windows"
defaults write com.apple.finder ShowStatusBar -bool true                                # Show Finder status bar

log_msg "Showing the path bar in Finder windows"
defaults write com.apple.finder ShowPathbar -bool true                                  # Show Finder path bar

log_msg "Expanding 'General' File Info pane"
defaults write com.apple.finder FXInfoPanesExpanded -dict-add General -bool true        # Expand General pane

log_msg "Expanding 'Open With' File Info pane"
defaults write com.apple.finder FXInfoPanesExpanded -dict-add OpenWith -bool true       # Expand Open With pane

log_msg "Expanding 'Privileges' File Info pane"
defaults write com.apple.finder FXInfoPanesExpanded -dict-add Privileges -bool true     # Expand Privileges pane

log_msg "Sorting folders first in window views"
defaults write com.apple.finder _FXSortFoldersFirst -bool true                          # Keep folders on top when sorting

log_msg "Searching the current folder by default"
defaults write com.apple.finder FXDefaultSearchScope -string "SCcf"                     # Set default search scope to current folder

log_msg "Setting default Finder view to list"
defaults write com.apple.finder FXPreferredViewStyle -string "Nlsv"                     # Set default view to list view

log_msg "Disabling the file extension change warning"
defaults write com.apple.finder FXEnableExtensionChangeWarning -bool false              # Disable file extension change warning

log_msg "Disabling .DS_Store file creation on network"
defaults write com.apple.desktopservices DSDontWriteNetworkStores -bool true            # Prevent .DS_Store files on network volumes

log_msg "Disabling .DS_Store file creation on USB"
defaults write com.apple.desktopservices DSDontWriteUSBStores -bool true                # Prevent .DS_Store files on USB volumes

log_msg "Disabling disk image verification"
defaults write com.apple.frameworks.diskimages skip-verify -bool true                   # Disable verification for local images

log_msg "Disabling locked disk image verification"
defaults write com.apple.frameworks.diskimages skip-verify-locked -bool true            # Disable verification for locked images

log_msg "Disabling remote disk image verification"
defaults write com.apple.frameworks.diskimages skip-verify-remote -bool true            # Disable verification for remote images

log_msg "Opening read-only disk images on mount"
defaults write com.apple.frameworks.diskimages auto-open-ro-root -bool true             # Auto-open for read-only volumes

log_msg "Opening read-write disk images on mount"
defaults write com.apple.frameworks.diskimages auto-open-rw-root -bool true             # Auto-open for read-write volumes

log_msg "Opening new Finder window for new disks"
defaults write com.apple.finder OpenWindowForNewRemovableDisk -bool true                # Open new window for removable disks

log_msg "Showing item info below desktop icons"
pb_set ~/Library/Preferences/com.apple.finder.plist DesktopViewSettings:IconViewSettings:showItemInfo bool true      # Show item info on desktop

log_msg "Showing item info in Finder icon views"
pb_set ~/Library/Preferences/com.apple.finder.plist FK_StandardViewSettings:IconViewSettings:showItemInfo bool true  # Show item info in foreign key views

log_msg "Showing item info in standard icon views"
pb_set ~/Library/Preferences/com.apple.finder.plist StandardViewSettings:IconViewSettings:showItemInfo bool true     # Show item info in standard views

log_msg "Placing icon labels on the right side"
pb_set ~/Library/Preferences/com.apple.finder.plist DesktopViewSettings:IconViewSettings:labelOnBottom bool false    # Set icon label position

log_msg "Enabling snap-to-grid on the desktop"
pb_set ~/Library/Preferences/com.apple.finder.plist DesktopViewSettings:IconViewSettings:arrangeBy string grid       # Enable desktop snap-to-grid

log_msg "Enabling snap-to-grid in Finder icon views"
pb_set ~/Library/Preferences/com.apple.finder.plist FK_StandardViewSettings:IconViewSettings:arrangeBy string grid   # Enable foreign key view snap-to-grid

log_msg "Enabling snap-to-grid in standard icon views"
pb_set ~/Library/Preferences/com.apple.finder.plist StandardViewSettings:IconViewSettings:arrangeBy string grid      # Enable standard view snap-to-grid

log_msg "Setting desktop grid spacing to 100px"
pb_set ~/Library/Preferences/com.apple.finder.plist DesktopViewSettings:IconViewSettings:gridSpacing real 100        # Set desktop grid spacing

log_msg "Setting Finder grid spacing to 100px"
pb_set ~/Library/Preferences/com.apple.finder.plist FK_StandardViewSettings:IconViewSettings:gridSpacing real 100    # Set foreign key view grid spacing

log_msg "Setting standard view grid spacing to 100px"
pb_set ~/Library/Preferences/com.apple.finder.plist StandardViewSettings:IconViewSettings:gridSpacing real 100       # Set standard view grid spacing

log_msg "Setting desktop icon size to 80px"
pb_set ~/Library/Preferences/com.apple.finder.plist DesktopViewSettings:IconViewSettings:iconSize integer 80         # Set desktop icon size

log_msg "Setting Finder icon size to 80px"
pb_set ~/Library/Preferences/com.apple.finder.plist FK_StandardViewSettings:IconViewSettings:iconSize integer 80     # Set foreign key view icon size

log_msg "Setting standard view icon size to 80px"
pb_set ~/Library/Preferences/com.apple.finder.plist StandardViewSettings:IconViewSettings:iconSize integer 80        # Set standard view icon size

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# ■ SECTION: SAFARI & WEBKIT
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
log_section "Configuring Safari and WebKit..."

log_msg "Disabling Universal Search"
defaults write com.apple.Safari UniversalSearchEnabled -bool false                       # Don't send search queries to Apple

log_msg "Disabling search suggestions"
defaults write com.apple.Safari SuppressSearchSuggestions -bool true                     # Don't send search suggestions to Apple

log_msg "Showing the full URL in the search field"
defaults write com.apple.Safari ShowFullURLInSmartSearchField -bool true                 # Show full URL

log_msg "Setting Safari's homepage to blank"
defaults write com.apple.Safari Homepage -string "about:blank"                           # Set homepage to about:blank

log_msg "Disabling automatic opening of safe files"
defaults write com.apple.Safari AutoOpenSafeDownloads -bool false                        # Don't open safe files automatically

log_msg "Hiding Safari's favorites bar by default"
defaults write com.apple.Safari ShowFavoritesBar -bool false                             # Hide favorites bar

log_msg "Hiding Safari's sidebar in Top Sites"
defaults write com.apple.Safari ShowSidebarInTopSites -bool false                        # Hide sidebar in Top Sites

log_msg "Disabling Safari's thumbnail cache"
defaults write com.apple.Safari DebugSnapshotsUpdatePolicy -int 2                        # Disable thumbnail cache

log_msg "Enabling 'contains' search by default"
defaults write com.apple.Safari FindOnPageMatchesWordStartsOnly -bool false              # Set find-on-page to match any part of a word

log_msg "Removing unneeded bookmarks bar icons"
defaults write com.apple.Safari ProxiesInBookmarksBar "()"                               # Remove proxy icons

log_msg "Enabling continuous spell checking"
defaults write com.apple.Safari WebContinuousSpellCheckingEnabled -bool true             # Enable spell check

log_msg "Disabling automatic spelling correction"
defaults write com.apple.Safari WebAutomaticSpellingCorrectionEnabled -bool false        # Disable auto-correct

log_msg "Disabling address book auto-fill"
defaults write com.apple.Safari AutoFillFromAddressBook -bool false                      # Disable address book auto-fill

log_msg "Disabling password auto-fill"
defaults write com.apple.Safari AutoFillPasswords -bool false                            # Disable password auto-fill

log_msg "Disabling credit card auto-fill"
defaults write com.apple.Safari AutoFillCreditCardData -bool false                       # Disable credit card auto-fill

log_msg "Disabling miscellaneous form auto-fill"
defaults write com.apple.Safari AutoFillMiscellaneousForms -bool false                   # Disable miscellaneous form auto-fill

log_msg "Enabling fraudulent website warnings"
defaults write com.apple.Safari WarnAboutFraudulentWebsites -bool true                   # Warn about fraudulent websites

log_msg "Disabling automatic pop-up windows"
defaults write com.apple.Safari WebKitJavaScriptCanOpenWindowsAutomatically -bool false  # Prevent pop-ups

log_msg "Disabling automatic pop-up windows (Content)"
defaults write com.apple.Safari com.apple.Safari.ContentPageGroupIdentifier.WebKit2JavaScriptCanOpenWindowsAutomatically -bool false  # Prevent content-specific pop-ups

log_msg "Disallowing inline video playback"
defaults write com.apple.Safari WebKitMediaPlaybackAllowsInline -bool false                                               # Disable inline video

log_msg "Disallowing inline video playback (Tech Preview)"
defaults write com.apple.SafariTechnologyPreview WebKitMediaPlaybackAllowsInline -bool false                              # Disable inline video in Safari Tech Preview

log_msg "Disallowing inline video playback (Content)"
defaults write com.apple.Safari com.apple.Safari.ContentPageGroupIdentifier.WebKit2AllowsInlineMediaPlayback -bool false  # Disable content-specific inline video

log_msg "Disallowing inline video playback (Content, Tech Preview)"
defaults write com.apple.SafariTechnologyPreview com.apple.Safari.ContentPageGroupIdentifier.WebKit2AllowsInlineMediaPlayback -bool false  # Disable content-specific inline video in Tech Preview

log_msg "Enabling the 'Do Not Track' HTTP header"
defaults write com.apple.Safari SendDoNotTrackHTTPHeader -bool true              # Send Do Not Track header

log_msg "Enabling automatic extension updates"
defaults write com.apple.Safari InstallExtensionUpdatesAutomatically -bool true  # Auto-update extensions

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
