#!/bin/sh
# Fetch tinyhook's third-party installers (Hopper DMGs etc.). They are
# release assets, not git content, so a fresh clone lacks them and app
# flows that mount DMGs would fail. Cheap no-op when already present.

tinyhook_dir="$HOME/Documents/Git/tinyhook"
[ -d "$tinyhook_dir/installers" ] || exit 0
ls "$tinyhook_dir"/installers/*.dmg >/dev/null 2>&1 && exit 0
command -v gh >/dev/null 2>&1 || exit 0

echo -e "\033[1;34m[Autopatch]\033[0m Fetching app installers from tinyhook release..."
(cd "$tinyhook_dir" && gh release download vendor-v1 -R RyoKamui/tinyhook --dir installers) || true
