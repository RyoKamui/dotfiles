{{- if (eq .chezmoi.os "darwin") -}}
#!/usr/bin/env zsh

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# ■ DEPLOYMENT SUMMARY
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# Runs last in the chain and prints everything the fail-soft scripts
# recorded in the shared log, so incomplete stages are impossible to miss.
# When failures exist it also drives the automatic retry: chezmoi only
# writes a script's run-once record after that script exits successfully,
# so a soft-failed (exit-0) stage is re-armed by deleting that record. The
# records live in the scriptState bucket, keyed by the script's content
# SHA256 (there is no "run_once" bucket), and entryState already stores the
# hash for each script's target path — rearm_run_once reads it from there.
# This script deletes the armed records BEFORE its nested retry pass, so
# the nested 'chezmoi apply' genuinely re-runs them, and again after the
# pass if they still failed, then exits non-zero — that keeps its own
# record unwritten too, and the cycle repeats on the next 'chezmoi apply'
# until every stage is green. The CHEZMOI_DEPLOY_RETRY marker gives the
# nested pass a single retry per apply so nothing spirals.
# Every script rewrites only its own log prefix when it runs, so the log is
# the current status of every stage, never a stale list. Stages that intentionally do not self-heal (huge builds, app
# installs) print their own manual re-run command into the log instead.

deploy_log="$HOME/.local/state/chezmoi-deploy.log"

# rearm_run_once <target path>: delete a script's run-once record so the next
# apply re-runs it. The key is the script's content SHA256, which entryState
# already holds for the target path — no need to recompute it.
rearm_run_once() {
    local hash
    hash=$(chezmoi state get --bucket=entryState --key="$1" 2>/dev/null | jq -r '.contentsSHA256 // empty' 2>/dev/null)
    [[ -n "$hash" ]] && chezmoi state delete --bucket=scriptState --key="$hash" 2>/dev/null
}

init_target="$HOME/.chezmoiscripts/10_init.sh"

if [[ ! -s "$deploy_log" ]]; then
    echo -e "\033[1;32m✔ Deployment complete — every stage succeeded.\033[0m"
    exit 0
fi

echo ""
echo -e "\033[1;33m┏━━ Deployment finished with $(wc -l < "$deploy_log" | tr -d ' ') incomplete stage(s) ━━━━━━━━━━━━━━━━━━━━━━\033[0m"
while IFS= read -r line; do
    echo -e "  \033[1;31m✗\033[0m $line"
done < "$deploy_log"

# Re-arm BEFORE the nested pass: the soft-failed stages already have their
# records written (they exited 0), so the nested apply would skip them unless
# their records are deleted first.
if grep -q '^init: ' "$deploy_log"; then
    rearm_run_once "$init_target"
fi

if [[ -n "${CHEZMOI_DEPLOY_RETRY:-}" ]]; then
    echo -e "\033[1;33m┃ Still failing after the automatic retry — everything stays re-armed for the next apply.\033[0m"
else
    echo -e "\033[1;33m┃ Retrying the self-healing stages now...\033[0m"
    CHEZMOI_DEPLOY_RETRY=1 chezmoi apply >/dev/null 2>&1
    if [[ -s "$deploy_log" ]]; then
        echo -e "  \033[1;31m✗\033[0m still incomplete after retry:"
        while IFS= read -r line; do
            echo -e "    \033[1;31m→\033[0m $line"
        done < "$deploy_log"
    else
        echo -e "  \033[1;32m✔\033[0m retry pass completed cleanly"
    fi
fi
echo -e "\033[1;33m┃ Full log: ${deploy_log}\033[0m"
echo -e "\033[1;33m┗━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┛\033[0m"

# Keep the loop alive: if a self-healing stage still fails after the retry
# pass, delete its run-once record again so the next 'chezmoi apply' re-runs
# it, then exit non-zero so this script's own record stays unwritten too. The
# next apply repeats the cycle until the log is empty — at which point this
# script exits 0 and everything settles.
if grep -q '^init: ' "$deploy_log"; then
    rearm_run_once "$init_target"
fi
exit 1
{{ end -}}
