#!/usr/bin/env zsh

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# ■ INSTALL TOOLCHAINS
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# This script clones and builds development toolchains from source.

# ────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# ■ SECTION: HIKARI LLVM
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

# Build Hikari LLVM obfuscation compiler from source
hikari_dir="$HOME/Documents/Git/hikari"
deploy_log="$HOME/.local/state/chezmoi-deploy.log"
mkdir -p "${deploy_log:h}"
github_ssh_command="ssh -o BatchMode=yes -o PreferredAuthentications=publickey -o PasswordAuthentication=no -o KbdInteractiveAuthentication=no"

if [ ! -f "$hikari_dir/build/install/bin/clang" ]; then
    echo -e "\033[1;34m[INFO]\033[0m Cloning Hikari LLVM..."
    rm -rf "$hikari_dir"
    mkdir -p "$HOME/.ssh"
    chmod 700 "$HOME/.ssh"
    ssh-keyscan -t ed25519 github.com >> "$HOME/.ssh/known_hosts" 2>/dev/null
    if ! GIT_ASKPASS=/bin/false GIT_TERMINAL_PROMPT=0 GIT_SSH_COMMAND="$github_ssh_command" \
        git clone --depth 1 git@github.com:RyoKamui/hikari.git "$hikari_dir"; then
        # Skip instead of exit 1: a missing SSH key must not block the scripts that run after this one
        echo -e "\033[1;33m[WARN]\033[0m Failed to clone Hikari over SSH. Load a GitHub SSH key, then re-run:"
        echo -e "\033[1;33m[WARN]\033[0m   chezmoi state forget-key 'script:home/.chezmoiscripts/run_once_after_20_toolchains.sh.tmpl' && chezmoi apply"
        echo "toolchains: Hikari clone failed — load GitHub SSH key and re-run the forget-key command above" >> "$deploy_log"
        exit 0
    fi

    echo -e "\033[1;34m[INFO]\033[0m Building Hikari LLVM (this may take a while)..."
    mkdir -p "$hikari_dir/build"
    cd "$hikari_dir/build"

    # Chain the build stages: without -e a failed cmake would otherwise fall through
    # into ninja and report a bogus success
    if cmake -G Ninja \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_OSX_ARCHITECTURES=arm64 \
        -DLLVM_ENABLE_PROJECTS="clang;lld" \
        -DLLVM_TARGETS_TO_BUILD="X86;ARM;AArch64" \
        -DLLVM_ENABLE_ZSTD=OFF \
        -DCMAKE_OSX_DEPLOYMENT_TARGET=12.0 \
        -DLLVM_CREATE_XCODE_TOOLCHAIN=ON \
        -DLLVM_INCLUDE_TESTS=OFF \
        -DLLVM_INCLUDE_EXAMPLES=OFF \
        -DLLVM_INCLUDE_UTILS=OFF \
        -DLLVM_INCLUDE_BENCHMARKS=OFF \
        -DLLVM_BUILD_TOOLS=OFF \
        -DLLVM_INSTALL_TOOLCHAIN_ONLY=ON \
        -DCMAKE_INSTALL_PREFIX="./install" \
        ../llvm && ninja && ninja install-xcode-toolchain; then
        echo -e "\033[1;32m[Done]\033[0m Hikari LLVM built successfully."
    else
        echo -e "\033[1;33m[WARN]\033[0m Hikari build failed. Fix the issue, then re-run from the cache:"
        echo -e "\033[1;33m[WARN]\033[0m   cd $hikari_dir/build && ninja && ninja install-xcode-toolchain"
        echo "toolchains: Hikari build failed — re-run: cd $hikari_dir/build && ninja && ninja install-xcode-toolchain" >> "$deploy_log"
    fi
else
    echo -e "\033[1;33m[SKIP]\033[0m Hikari LLVM already built."
fi

{{ end -}}
