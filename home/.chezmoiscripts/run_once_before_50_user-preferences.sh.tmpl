defaults write com.apple.WindowManager EnableStandardClickToShowDesktop -int 0

log_msg "Configuring Dock items with dockutil"
apps_to_add_to_dock=(
  "Mail" "BusyCal" "Bloom" "Helium"
  "AyuGram" "WeChat" "WhatsApp" "News Explorer"
  "Fork" "Transmit" "Octarine" "Numi" "qBittorrent"
  "Rclone Browser" "Surge" "TablePlus" "WezTerm" "Zed"
  "System Settings"
)
IFS=""
for app in "${apps_to_add_to_dock[@]}"; do
  if [[ -d "/Applications/${app}.app" ]]; then
    dockutil --add "/Applications/${app}.app" --no-restart >/dev/null 2>&1
  elif [[ -d "/System/Applications/${app}.app" ]]; then
    dockutil --add "/System/Applications/${app}.app" --no-restart >/dev/null 2>&1
  fi
done

log_msg "Restarting the Dock to apply changes"
killall Dock                                                                                                         # Apply Dock changes

