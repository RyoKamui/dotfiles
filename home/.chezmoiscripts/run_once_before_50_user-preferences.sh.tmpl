log_msg "Removing all default apps from the Dock"
defaults write com.apple.dock persistent-apps -array                                                                 # Clear default Dock apps

log_msg "Adding a highlight effect to Dock stacks"
defaults write com.apple.dock mouse-over-hilite-stack -bool true                                                     # Enable highlight effect for stacks

log_msg "Setting Dock icon size to 64px"
defaults write com.apple.dock tilesize -int 64                                                                       # Set icon size to 64px

log_msg "Setting Dock animation to scale effect"
defaults write com.apple.dock mineffect -string "scale"                                                              # Use scale effect for minimization

log_msg "Minimizing windows into app icons"
defaults write com.apple.dock minimize-to-application -bool true                                                     # Minimize to app icon

log_msg "Enabling spring loading for all Dock items"
defaults write com.apple.dock enable-spring-load-actions-on-all-items -bool true                                     # Enable spring loading

log_msg "Showing indicator lights for open apps"
defaults write com.apple.dock show-process-indicators -bool true                                                     # Show open application indicators

log_msg "Setting a slow Dock opening animation"
defaults write com.apple.dock expose-animation-duration -float 1                                                     # Set animation speed

log_msg "Disabling auto-rearranging of Spaces"
defaults write com.apple.dock mru-spaces -bool false                                                                 # Disable auto-rearranging spaces based on use

log_msg "Setting the Dock to auto-hide"
defaults write com.apple.dock autohide -bool true                                                                    # Enable Dock auto-hiding

log_msg "Setting a fast Dock auto-hide delay"
defaults write com.apple.dock autohide-delay -float 0.05                                                             # Set auto-hide delay

log_msg "Setting a fast Dock show/hide animation"
defaults write com.apple.dock autohide-time-modifier -float 0.25                                                     # Set animation time

log_msg "Showing hidden applications in the Dock"
defaults write com.apple.dock showhidden -bool true                                                                  # Show hidden app icons as translucent

log_msg "Disabling recent applications in the Dock"
defaults write com.apple.dock show-recents -bool false                                                               # Do not show recent apps in Dock

