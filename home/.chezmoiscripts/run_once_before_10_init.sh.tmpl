{{- if (eq .chezmoi.os "darwin") -}}
#!/usr/bin/env zsh

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# ■ INITIALIZE SYSTEM AND INSTALL CORE DEPENDENCIES
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# This script prepares the system by creating necessary directories, setting the wallpaper,
# and installing essential tools like Xcode CLI, Homebrew, Volta-managed Node.js, and Rust.
# Steps are fail-soft: a retried-and-still-failing step is recorded and skipped so later
# steps always run, instead of one flaky download aborting the whole deploy.

# Keep sudo session alive
sudo -v
while true; do sudo -n true; sleep 60; kill -0 "$$" || exit; done 2>/dev/null &

# Safety flags: -u error on unset vars, -o pipefail catch pipeline errors, -f disable glob expansion.
# No -e on purpose: the step() helper below owns failure handling so nothing can abort the run.
set -uf -o pipefail

# Steps that permanently failed after all retries, reported in the final summary
failed_steps=()

# step <description> <attempts> <function>: run a function with retries and a backoff,
# recording a permanent failure instead of aborting the script
step() {
    local desc="$1" max="$2" attempt=1
    shift 2
    while ! "$@"; do
        if (( attempt >= max )); then
            echo -e "\033[1;31m[FAIL]\033[0m ${desc} (after ${attempt} attempts) — re-run manually: $*"
            failed_steps+="${desc}"
            return 0
        fi
        echo -e "\033[1;33m[RETRY]\033[0m ${desc} failed (attempt ${attempt}/${max}), retrying in 10s..."
        (( attempt += 1 ))
        sleep 10
    done
    echo -e "\033[1;32m[OK]\033[0m ${desc}"
}

# Make brew downloads fail fast on stalled connections (not slow ones) so retries can help
export HOMEBREW_CURL_RETRIES=5
export HOMEBREW_CURL_SPEED_LIMIT=100
export HOMEBREW_CURL_SPEED_TIME=60

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# ■ SECTION: SYSTEM PREPARATION
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

# Create organized directories for incoming files, anki decks, git and torrent watch folder
mkdir -p ~/Documents/{_Incoming,Anki,Git}
mkdir -p ~/Downloads/_Watch
[[ -d ~/Pictures/Wallpapers ]] || mkdir -p ~/Pictures/Wallpapers

# Download and set the desktop wallpaper (-f so an error page is never saved as the image)
set_wallpaper() {
    curl -fL --retry 3 --retry-delay 2 --connect-timeout 15 --max-time 300 \
        -o ~/Pictures/Wallpapers/blobs.webp \
        "https://github.com/RyoKamui/assets/raw/refs/heads/main/wallpapers/blobs.webp" &&
    osascript -e 'tell application "System Events" to set picture of every desktop to ("~/Pictures/Wallpapers/blobs.webp" as POSIX file)'
}
step "desktop wallpaper" 3 set_wallpaper

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# ■ SECTION: CORE DEPENDENCIES
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

install_xcode_cli() {
    if pkgutil --pkg-info com.apple.pkg.CLTools_Executables >/dev/null 2>&1; then
        echo "Xcode CLI tools already installed."
        return 0
    fi
    echo "Xcode CLI tools not found. Installing them..."
    touch /tmp/.com.apple.dt.CommandLineTools.installondemand.in-progress
    # Find the correct Command Line Tools package name
    local tools
    tools=$(/usr/sbin/softwareupdate --list 2>&1 | \
        /usr/bin/awk -F: '/Label: Command Line Tools for Xcode/ {print $NF}' | \
        /usr/bin/sed 's/^ *//' | \
        /usr/bin/tail -1)
    [[ -n "$tools" ]] || return 1
    /usr/sbin/softwareupdate -i "$tools" --agree-to-license
}
step "Xcode CLI tools" 2 install_xcode_cli
rm -f /tmp/.com.apple.dt.CommandLineTools.installondemand.in-progress

install_homebrew() {
    if command -v brew >/dev/null 2>&1; then
        echo "Homebrew already installed"
        brew -v
        return 0
    fi
    echo "Installing Homebrew..."
    # NONINTERACTIVE so the installer never hangs waiting on a prompt
    if NONINTERACTIVE=1 /bin/bash -c "$(curl -fsSL --retry 3 https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"; then
        grep -q 'brew shellenv' ~/.zprofile 2>/dev/null || echo 'eval $(/opt/homebrew/bin/brew shellenv)' >> ~/.zprofile
        eval "$(/opt/homebrew/bin/brew shellenv)"
    else
        return 1
    fi
}
step "Homebrew" 2 install_homebrew

# Without brew nothing downstream can proceed; this stays a hard stop by design
if ! command -v brew >/dev/null 2>&1; then
    echo -e "\033[1;31m[ERROR]\033[0m Homebrew is unavailable, cannot continue. Fix the network and re-run 'chezmoi apply'."
    exit 1
fi

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# ■ SECTION: BUNDLE INSTALLATION
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

# brew bundle is resumable: already-satisfied entries are skipped, so a retry picks
# up exactly where a failed package left off
install_packages() { brew bundle install --file "{{ joinPath .chezmoi.sourceDir "packages_mac" }}"; }
step "brew bundle (packages_mac)" 3 install_packages

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# ■ SECTION: JAVASCRIPT TOOLCHAIN
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

export VOLTA_HOME="${VOLTA_HOME:-$HOME/.volta}"
export PATH="$VOLTA_HOME/bin:$PATH"

install_node() { volta install node; }
step "Volta Node.js" 3 install_node

# OpenCode V2 CLI (provides opencode2); npm's own retry ladder covers flaky fetches
install_opencode() { npm install -g --fetch-retries=5 --fetch-retry-maxtimeout=120000 @opencode-ai/cli@dev; }
step "@opencode-ai/cli (opencode2)" 3 install_opencode

install_rust() { rustup-init -y; }
step "Rust toolchain" 2 install_rust

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# ■ SECTION: SUMMARY
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

if (( ${#failed_steps[@]} > 0 )); then
    echo ""
    echo -e "\033[1;33m┏━━ Init finished with ${#failed_steps[@]} failed step(s) ━━━━━━━━━━━━━━━━━━━━━\033[0m"
    printf '  \033[1;31m✗\033[0m %s\n' "${failed_steps[@]}"
    echo -e "\033[1;33m┃ Each prints its own re-run command above; re-run once the network recovers.\033[0m"
    echo -e "\033[1;33m┗━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\033[0m"
fi
exit 0
{{ end -}}
