{{- if (eq .chezmoi.os "darwin") -}}
#!/usr/bin/env zsh

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# ■ INITIALIZE SYSTEM AND INSTALL CORE DEPENDENCIES
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# This script prepares the system by creating necessary directories, setting the wallpaper,
# and installing essential tools like Xcode CLI, Homebrew, Volta-managed Node.js, and Rust.

# Keep sudo session alive
sudo -v
while true; do sudo -n true; sleep 60; kill -0 "$$" || exit; done 2>/dev/null &

# Safety flags: -e exit on error, -u error on unset vars, -o pipefail catch pipeline errors, -f disable glob expansion
set -eufo pipefail

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# ■ SECTION: SYSTEM PREPARATION
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

# Create organized directories for incoming files, anki decks, git and torrent watch folder
mkdir -p ~/Documents/{_Incoming,Anki,Git}
mkdir -p ~/Downloads/_Watch
if [[ ! -d ~/Pictures/Wallpapers ]]; then
   mkdir -p ~/Pictures/Wallpapers
fi

# Download and set the desktop wallpaper
curl -o ~/Pictures/Wallpapers/blobs.webp -L "https://github.com/RyoKamui/assets/raw/refs/heads/main/wallpapers/blobs.webp"
if [ ! -f ~/Pictures/Wallpapers/blobs.webp ]; then
    echo "Error: Downloaded wallpaper file not found"
    exit 1
fi
osascript -e 'tell application "System Events" to set picture of every desktop to ("~/Pictures/Wallpapers/blobs.webp" as POSIX file)'

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# ■ SECTION: CORE DEPENDENCIES
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

echo "Checking for Xcode CLI..."
if pkgutil --pkg-info com.apple.pkg.CLTools_Executables >/dev/null 2>&1; then
    echo "Xcode CLI tools already installed."
else
    echo "Xcode CLI tools not found. Installing them..."
    touch /tmp/.com.apple.dt.CommandLineTools.installondemand.in-progress
    # Find the correct Command Line Tools package name
    xcodeCommandLineTools=$(/usr/sbin/softwareupdate --list 2>&1 | \
        /usr/bin/awk -F: '/Label: Command Line Tools for Xcode/ {print $NF}' | \
        /usr/bin/sed 's/^ *//' | \
        /usr/bin/tail -1)
    softwareupdate -i "$xcodeCommandLineTools" --agree-to-license
fi

echo "Checking for Homebrew..."
if [[ $(command -v brew) ]]; then
    echo "Homebrew already installed"
    brew -v
else
    echo "Installing Homebrew..."
    /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
    echo 'eval $(/opt/homebrew/bin/brew shellenv)' >> ~/.zprofile
    eval $(/opt/homebrew/bin/brew shellenv)
fi

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# ■ SECTION: BUNDLE INSTALLATION
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

brew bundle install --file "{{ joinPath .chezmoi.sourceDir "packages_mac" }}"

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# ■ SECTION: JAVASCRIPT TOOLCHAIN
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

export VOLTA_HOME="${VOLTA_HOME:-$HOME/.volta}"
export PATH="$VOLTA_HOME/bin:$PATH"

echo "Installing Node.js via Volta..."
volta install node

# OpenCode V2 CLI (provides opencode2)
echo "Installing @opencode-ai/cli (opencode2)..."
npm install -g @opencode-ai/cli@dev

echo "Installing Rust via rustup-init..."
rustup-init -y
{{ end -}}
