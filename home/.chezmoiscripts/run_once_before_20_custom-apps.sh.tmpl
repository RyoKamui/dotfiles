{{- if (eq .chezmoi.os "darwin") -}}
#!/usr/bin/env zsh

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# ■ INSTALL CUSTOM APPLICATIONS
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# This script downloads, extracts, and installs custom applications not available
# through package managers.

setopt NULL_GLOB # Skip the loops below instead of iterating over a literal '*' when nothing matches

deploy_log="$HOME/.local/state/chezmoi-deploy.log"
mkdir -p "${deploy_log:h}"
sed -i "" '/^custom-apps: /d' "$deploy_log" 2>/dev/null # drop last run's entries; a success now leaves no trace

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# ■ SECTION: APPLICATION SOURCES
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

# Packages to install, read from GitHub releases at runtime in "<owner/repo> <tag or
# latest> <comma-separated app names>" form. An app is matched against the asset names
# of its release by prefix and the highest version wins, so a name is all that belongs
# here: new uploads, and the versions they carry, need no change in this file.
release_specs=(
    "RyoKamui/assets Binaries Cling,DriveDx,Hopper.Disassembler,IDA.Professional,Nucleus,Pixelmator.Pro,Surge"
    "sindresorhus/supercharge-meta latest Supercharge"
)

# Packages hosted outside of a GitHub release, which still need a pinned URL
pinned_urls=(
    "https://betamagic.nl/downloads/News%20Explorer%20Retail.zip"
)

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# ■ SECTION: RESOLVE LATEST RELEASE ASSETS
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

# JSON tool preference: jq ships with macOS (Tahoe+), jaq is the Homebrew
# alternative, and python3 (present via the Xcode CLI tools) is the last resort
# so a failed brew bundle can never abort app installs
json_tool=""
if command -v jq >/dev/null 2>&1; then
    json_tool="jq"
elif command -v jaq >/dev/null 2>&1; then
    json_tool="jaq"
elif command -v python3 >/dev/null 2>&1; then
    json_tool="python3"
fi

# Reads the metadata of one release, `gh` first because it is authenticated (higher
# rate limit) with curl as the fallback. The "latest" tag asks for the newest published
# release of a repo, anything else is a tag name. Retries cover transient API errors
# and rate limits; a persistent failure is surfaced by the caller.
fetch_release() {
    local repo="$1" tag="$2" endpoint json="" attempt
    if [[ "$tag" == "latest" ]]; then
        endpoint="releases/latest"
    else
        endpoint="releases/tags/${tag}"
    fi
    for attempt in 1 2 3; do
        json=""
        if command -v gh >/dev/null 2>&1; then
            json=$(gh api "repos/${repo}/${endpoint}" 2>/dev/null) || json=""
        fi
        if [[ -z "$json" ]]; then
            json=$(curl -fsSL --retry 3 -H "Accept: application/vnd.github+json" \
                "https://api.github.com/repos/${repo}/${endpoint}" 2>/dev/null) || json=""
        fi
        [[ -n "$json" ]] && break
        echo -e "\033[1;33m[WARN]\033[0m Unable to read the ${tag} release of ${repo} (attempt ${attempt}/3)"
        sleep 5
    done
    print -r -- "$json"
}

# Prints "<asset name>\t<download url>" for the newest asset of an app
latest_asset() {
    local json="$1" app="$2"
    if [[ "$json_tool" == "python3" ]]; then
        python3 -c '
import json, re, sys

app = sys.argv[1].lower()
try:
    release = json.load(sys.stdin)
except ValueError:
    sys.exit(0)

def version_key(name):
    match = re.search(r"v(\d+(?:\.\d+)*)", name)
    return [int(part) for part in match.group(1).split(".")] if match else [0]

assets = [asset for asset in release.get("assets", [])
          if asset.get("name", "").lower().startswith(app + ".")]
if not assets:
    sys.exit(0)
best = sorted(assets, key=lambda asset: version_key(asset["name"]))[-1]
print(best.get("name", "") + "\t" + best.get("browser_download_url", ""))
' "$app" <<< "$json"
        return
    fi
    print -r -- "$json" | "$json_tool" -r --arg app "$app" '
        def version_key:
            ((.name | capture("v(?<v>[0-9]+([.][0-9]+)*)") // {v: "0"}).v | split(".") | map(tonumber));
        [ .assets[]
          | select((.name | ascii_downcase) | startswith(($app | ascii_downcase) + ".")) ]
        | sort_by(version_key) | (.[-1] // empty)
        | [.name, .browser_download_url] | @tsv'
}

# Build the final list of packages to download
urls=("${pinned_urls[@]}")
if [[ -z "$json_tool" ]]; then
    echo -e "\033[1;33m[WARN]\033[0m Neither jq, jaq nor python3 is available — skipping GitHub release resolution, installing pinned URLs only"
    echo "custom-apps: no JSON tool available, release assets unresolved — re-run: chezmoi state delete --bucket=scriptState --key=\"\$(chezmoi state get --bucket=entryState --key=\"\$HOME/.chezmoiscripts/20_custom-apps.sh\" | jq -r .contentsSHA256)\" && chezmoi apply" >> "$deploy_log"
else
    for spec in "${release_specs[@]}"; do
        read -r repo tag apps <<< "$spec"
        release=$(fetch_release "$repo" "$tag")
        if [[ -z "$release" ]]; then
            # Skip this repo's apps after exhausting retries instead of exit 1, so the
            # remaining specs and pinned URLs still install on this run
            echo -e "\033[1;31m[WARN]\033[0m Skipping ${repo} apps after repeated failures; re-run the script when the API recovers"
            echo "custom-apps: ${repo} release metadata unavailable — re-run: chezmoi state delete --bucket=scriptState --key=\"\$(chezmoi state get --bucket=entryState --key=\"\$HOME/.chezmoiscripts/20_custom-apps.sh\" | jq -r .contentsSHA256)\" && chezmoi apply" >> "$deploy_log"
            continue
        fi
        for app in ${(s:,:)apps}; do
            if ! resolved=$(latest_asset "$release" "$app") || [[ -z "$resolved" ]]; then
                echo -e "\033[1;33m[WARN]\033[0m No ${repo} asset found for ${app}, skipping"
                continue
            fi
            echo -e "\033[1;32m[Resolved]\033[0m ${app} -> ${resolved%%$'\t'*}"
            urls+=("${resolved#*$'\t'}")
        done
    done
fi

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# ■ SECTION: DOWNLOAD, EXTRACT AND INSTALL
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

# Create a temporary working directory and navigate into it
tmp_dir="$HOME/temp-apps"
mkdir -p "$tmp_dir"
cd "$tmp_dir"

# Download all the specified URLs
echo -e "\033[1;34m[INFO]\033[0m Initiating download of application packages..."
for url in "${urls[@]}"; do
    echo -e "\033[1;32m[Downloading]\033[0m $url"
    # -f keeps a 404 from being saved as a bogus archive, so a moved asset is loud
    if ! curl -fL --retry 3 --retry-delay 2 -O "$url"; then
        echo -e "\033[1;31m[ERROR]\033[0m Failed to download $url"
        echo "custom-apps: download failed $url" >> "$deploy_log"
        rm -f "${url##*/}"
    fi
done

# Unzip all the downloaded .zip files in the temporary directory
echo -e "\033[1;34m[INFO]\033[0m Extracting all .zip files..."
for zip_file in *.zip; do
    echo -e "\033[1;32m[Extracting]\033[0m $zip_file"
    unzip -q "$zip_file" || { echo -e "\033[1;31m[ERROR]\033[0m Failed to extract $zip_file"; echo "custom-apps: extraction failed $zip_file" >> "$deploy_log"; }
done

# Install the .app directories
echo -e "\033[1;34m[INFO]\033[0m Installing applications to /Applications..."
for app_dir in *.app(/); do
    app_name=$(basename "$app_dir")
    app_dest="/Applications/$app_name"

    # Check if the application already exists in /Applications/ and remove the existing version if necessary
    if [ -d "$app_dest" ]; then
        echo -e "\033[1;33m[INFO]\033[0m Removing existing version of $app_name in /Applications/"
        sudo rm -rf "$app_dest"
    fi

    # Move the new application to /Applications/
    echo -e "\033[1;32m[Installing]\033[0m $app_name to /Applications/"
    sudo mv "$app_dir" /Applications/

    # Clear extended attributes on the moved app
    echo -e "\033[1;32m[Dequarantine]\033[0m Removing extended attributes for $app_name"
    sudo xattr -cr "/Applications/$app_name"
done

# Configure IDA Pro to use the system Python 3 (its bundle folder carries the version)
echo -e "\033[1;34m[INFO]\033[0m Configuring IDA Pro Python 3..."
for idapyswitch in /Applications/IDA\ Professional*.app/Contents/MacOS/idapyswitch; do
    sudo "$idapyswitch" --auto-apply
done

# Cleanup: Remove the temporary directory after the operation is complete
echo -e "\033[1;34m[INFO]\033[0m Done, removing temporary directory..."
rm -rf "$tmp_dir"
{{ end -}}
